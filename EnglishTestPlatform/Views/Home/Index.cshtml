@model List<Data.Entities.Test>
@{
    ViewData["Title"] = "Главная";
    var theories = ViewBag.Theories as List<Data.Entities.Theory>;
}
<div class="container mt-5">
    <h1 class="mb-4">📚 Учебная платформа по английскому языку</h1>

    <!-- Блок теории -->
    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <h3>📖 Теоретические материалы</h3>
        </div>
        <div class="card-body">
            @if (theories != null && theories.Any())
            {
                <div class="row">
                    @foreach (var theory in theories)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title">@theory.File.Name</h5>
                                    <a href="@Url.Action("Details", "Theory", new { id = theory.Id })"
                                       class="btn btn-outline-primary">Читать</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p>Теория ещё не добавлена.</p>
            }
        </div>
    </div>

    <!-- Блок тестов (как было) -->
    <div class="card">
        <div class="card-header bg-success text-white">
            <h3>✍️ Тесты</h3>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="row">
                    @foreach (var test in Model)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title">@test.File.Name</h5>
                                    <a href="@Url.Action("Take", "Test", new { testName = @test.File.Name })"
                                       class="btn btn-primary">Начать тест</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p>Нет доступных тестов.</p>
            }
        </div>
    </div>
</div>