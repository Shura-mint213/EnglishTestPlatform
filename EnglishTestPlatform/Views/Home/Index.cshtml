@{
    ViewData["Title"] = "Главная";
}
<div class="container mt-4">
    <!-- Хлебные крошки -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Главная</a></li>
            @foreach (var crumb in ViewBag.Breadcrumbs)
            {
                <li class="breadcrumb-item"><a href="@Url.Action("Index", new { sectionId = crumb.Id })">@crumb.Name</a></li>
            }
        </ol>
    </nav>

    <!-- Подразделы -->
    @if (ViewBag.Sections.Count > 0)
    {
        <div class="row mb-4">
            @foreach (var sec in ViewBag.Sections)
            {
                <div class="col-md-3 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">📁 @sec.Name</h5>
                            <a href="@Url.Action("Index", new { sectionId = sec.Id })" class="btn btn-outline-primary">Открыть</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Теории -->
    @if (ViewBag.Theories.Count > 0)
    {
        <h3>📖 Теоретические материалы</h3>
        <div class="row mb-4">
            @foreach (var theory in ViewBag.Theories)
            {
                <div class="col-md-4 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@theory.Name</h5>
                            <a href="@Url.Action("Details", "Theory", new { id = theory.Id })" class="btn btn-info">Читать</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Тесты -->
    @if (ViewBag.Tests.Count > 0)
    {
        <h3>✍️ Тесты</h3>
        <div class="row">
            @foreach (var test in ViewBag.Tests)
            {
                <div class="col-md-4 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@test.File.Name</h5>
                            <a href="@Url.Action("Take", "Test", new { testName = @test.File.Name })" class="btn btn-success">Пройти тест</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>