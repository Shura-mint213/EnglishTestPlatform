@model Data.Entities.Section
@{
    ViewData["Title"] = "Удаление раздела";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h3>⚠️ Подтверждение удаления</h3>
                </div>
                <div class="card-body">
                    <p>Вы уверены, что хотите удалить раздел <strong>«@Model.Name»</strong>?</p>

                    @{
                        var hasChildren = Model.ChildSections?.Any() ?? false;
                        var hasTheories = Model.Theories?.Any() ?? false;
                        var hasTests = Model.Tests?.Any() ?? false;
                    }

                    @if (hasChildren || hasTheories || hasTests)
                    {
                        <div class="alert alert-warning">
                            <strong>⚠️ Внимание!</strong> Раздел содержит:
                            <ul class="mb-0 mt-2">
                                @if (hasChildren)
                                {
                                    <li>📁 @Model.ChildSections.Count подраздел(ов)</li>
                                }
                                @if (hasTheories)
                                {
                                    <li>📖 @Model.Theories.Count теоретических материалов</li>
                                }
                                @if (hasTests)
                                {
                                    <li>✍️ @Model.Tests.Count тестов</li>
                                }
                            </ul>
                            <hr />
                            <p class="mb-0">Все эти элементы будут перемещены в родительский раздел.</p>
                        </div>
                    }

                    <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
                        <button type="submit" class="btn btn-danger">Да, удалить</button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Отмена</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>