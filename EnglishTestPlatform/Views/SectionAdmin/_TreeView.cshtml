@model List<Data.Entities.Section>

<div class="section-tree">
    @if (Model != null && Model.Any())
    {
        <ul class="list-unstyled">
            @foreach (var sec in Model.Where(s => s.ParentSectionId == null).OrderBy(s => s.OrderBy))
            {
                <li>
                    <div class="section-item mb-2">
                        <i class="bi bi-folder"></i>
                        <strong>@sec.Name</strong>
                        <a href="@Url.Action("Edit", new { id = sec.Id })" class="btn btn-sm btn-link">✏️</a>
                        <button type="button" class="btn btn-sm btn-link toggle-children" data-id="@sec.Id">
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    </div>
                    <div class="section-children" id="children-@sec.Id">
                        @await Html.PartialAsync("_TreeViewChildren", sec.ChildSections.ToList())
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">Нет доступных разделов</p>
    }
</div>

<script>
    document.querySelectorAll('.toggle-children').forEach(btn => {
        btn.addEventListener('click', function() {
            const id = this.dataset.id;
            const children = document.getElementById(`children-${id}`);
            const icon = this.querySelector('i');
            if (children.style.display === 'none') {
                children.style.display = 'block';
                icon.classList.remove('bi-chevron-right');
                icon.classList.add('bi-chevron-down');
            } else {
                children.style.display = 'none';
                icon.classList.remove('bi-chevron-down');
                icon.classList.add('bi-chevron-right');
            }
        });
    });
</script>

<style>
    .section-tree {
        max-height: 500px;
        overflow-y: auto;
    }
    .section-children {
        margin-left: 25px;
        padding-left: 10px;
        border-left: 1px dashed #ccc;
    }
    .section-item {
        padding: 5px 0;
    }
    .toggle-children {
        padding: 0 5px;
    }
</style>