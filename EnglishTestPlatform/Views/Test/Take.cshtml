@model EnglishTestPlatform.Models.TestModel
@{
    ViewData["Title"] = Model.TestTitle;
    var testName = ViewBag.TestName as string;
    var fullTestName = ViewBag.FullTestName as string ?? testName;
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1><i class="bi bi-clipboard-check me-2"></i>@Model.TestTitle</h1>
        <p class="lead text-muted">Ответьте на все вопросы и нажмите "Завершить тест"</p>
    </div>

    <form method="post" action="/Test/SubmitForm" id="testForm">
        <!-- Сохраняем имя теста -->
        <input type="hidden" name="testName" value="@testName" />

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            var questionName = $"Questions[{i}]";

            <div class="card mb-4 question-card" data-index="@i" data-type="@q.Type">
                <div class="card-header">
                    <span class="badge bg-light text-dark me-2">Вопрос @(i + 1)</span>
                    @q.Text
                </div>
                <div class="card-body">
                    @switch (q)
                    {
                        case MultipleChoiceQuestion mcq:
                            <div class="options-container">
                                @foreach (var opt in mcq.Options)
                                {
                                    <div class="form-check mb-3 p-3 border rounded hover-shadow cursor-pointer">
                                        <input class="form-check-input" type="radio"
                                               name="userAnswers[@i].Answer"
                                               value="@opt"
                                               id="q_@i@opt.Replace(" ", "_")" />
                                        <label class="form-check-label w-100 cursor-pointer" for="q_@i@opt.Replace(" ", "_")">
                                            @opt
                                        </label>
                                    </div>
                                }
                            </div>
                            <!-- Сохраняем индекс вопроса -->
                            <input type="hidden" name="userAnswers[@i].QuestionIndex" value="@i" />
                            break;

                        case MultipleSelectQuestion msq:
                            <div class="options-container">
                                @foreach (var opt in msq.Options)
                                {
                                    <div class="form-check mb-3 p-3 border rounded hover-shadow cursor-pointer">
                                        <input class="form-check-input" type="checkbox"
                                               name="userAnswers[@i].SelectedOptions"
                                               value="@opt"
                                               id="q_@i@opt.Replace(" ", "_")" />
                                        <label class="form-check-label w-100 cursor-pointer" for="q_@i@opt.Replace(" ", "_")">
                                            @opt
                                        </label>
                                    </div>
                                }
                            </div>
                            <input type="hidden" name="userAnswers[@i].QuestionIndex" value="@i" />
                            break;

                        case MatchingQuestion mq:
                            <div class="matching-container">
                                @for (int j = 0; j < mq.Pairs.Count; j++)
                                {
                                    var pair = mq.Pairs[j];
                                    <div class="row mb-3 align-items-center">
                                        <div class="col-md-5">
                                            <div class="p-3 bg-light rounded border">
                                                <strong>@pair.Left</strong>
                                            </div>
                                        </div>
                                        <div class="col-md-2 text-center">
                                            <i class="bi bi-arrow-right fs-4 text-primary"></i>
                                        </div>
                                        <div class="col-md-5">
                                            <select class="form-select form-select-lg"
                                                    name="userAnswers[@i].Matches[@j].Value"
                                                    data-left="@pair.Left">
                                                <option value="">-- Выберите соответствие --</option>
                                                @foreach (var target in mq.Pairs.Select(p => p.Right))
                                                {
                                                    <option value="@target">@target</option>
                                                }
                                            </select>
                                            <input type="hidden" name="userAnswers[@i].Matches[@j].Key" value="@pair.Left" />
                                        </div>
                                    </div>
                                }
                            </div>
                            <input type="hidden" name="userAnswers[@i].QuestionIndex" value="@i" />
                            break;

                        case FillInQuestion fiq:
                            <div class="mb-3">
                                <input type="text" class="form-control form-control-lg"
                                       name="userAnswers[@i].Answer"
                                       placeholder="Введите ваш ответ здесь..." />
                            </div>
                            <input type="hidden" name="userAnswers[@i].QuestionIndex" value="@i" />
                            break;
                    }
                </div>
            </div>
        }

        <div class="text-center mt-5 mb-5">
            <button type="submit" class="btn btn-success btn-lg px-5 py-3">
                <i class="bi bi-check-circle me-2"></i>Завершить тест
            </button>
        </div>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/cheatsheet.css" />
    <style>
        .hover-shadow:hover {
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            background-color: #f8f9fa;
        }
        
        .cursor-pointer {
            cursor: pointer;
        }
        
        .form-check-input:checked + .form-check-label {
            font-weight: 600;
            color: #667eea;
        }
        
        .options-container .form-check {
            transition: all 0.3s ease;
        }
    </style>
}

@section Scripts {
    <script src="~/js/cheatsheet.js"></script>
    <script>
        window.testName = "@fullTestName";

        // Сохранение прогресса (опционально)
        function saveProgress() {
            const answers = {};
            document.querySelectorAll('.form-check-input:checked, .form-control, .form-select').forEach(el => {
                if (el.name) {
                    answers[el.name] = el.value;
                }
            });
            localStorage.setItem(`test_${window.testName}_progress`, JSON.stringify(answers));
        }

        // Автосохранение
        document.querySelectorAll('.form-check-input, .form-select, .form-control').forEach(el => {
            el.addEventListener('change', saveProgress);
            el.addEventListener('input', saveProgress);
        });

        // Восстановление прогресса
        const saved = localStorage.getItem(`test_${window.testName}_progress`);
        if (saved) {
            const answers = JSON.parse(saved);
            Object.keys(answers).forEach(name => {
                const el = document.querySelector(`[name="${name}"]`);
                if (el) {
                    if (el.type === 'checkbox' || el.type === 'radio') {
                        if (el.value === answers[name]) el.checked = true;
                    } else {
                        el.value = answers[name];
                    }
                }
            });
        }
    </script>
}