@model EnglishTestPlatform.ViewModel.TestViewModel
@{
    ViewData["Title"] = "Создать тест";
}

<div class="container mt-4">
    <h1>📝 Создать новый тест</h1>
    <hr />

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <strong>Ошибки валидации:</strong>
            <ul>
                @foreach (var key in ViewData.ModelState.Keys)
                {
                    foreach (var error in ViewData.ModelState[key].Errors)
                    {
                        <li>@key: @error.ErrorMessage</li>
                    }
                }
            </ul>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Название теста *</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SectionId" class="form-label">Раздел</label>
                    <select asp-for="SectionId" class="form-select">
                        <option value="">-- Без раздела --</option>
                        @if (Model.Sections != null)
                        {
                            @foreach (var sec in Model.Sections)
                            {
                                <option value="@sec.Id">@sec.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="File" class="form-label">JSON файл теста *</label>
                    <input asp-for="File" type="file" class="form-control" accept=".json" />
                    <span asp-validation-for="File" class="text-danger"></span>
                    <small class="text-muted">Загрузите JSON файл с вопросами теста</small>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-success">Сохранить</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}