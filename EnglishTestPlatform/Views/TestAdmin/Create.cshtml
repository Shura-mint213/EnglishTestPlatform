@model EnglishTestPlatform.ViewModel.TestViewModel
@{
    ViewData["Title"] = "Создать тест";
}

<div class="container mt-4">
    <h1>📝 Создать новый тест</h1>
    <hr />

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <strong>Ошибки валидации:</strong>
            <ul>
                @foreach (var key in ViewData.ModelState.Keys)
                {
                    foreach (var error in ViewData.ModelState[key].Errors)
                    {
                        <li>@key: @error.ErrorMessage</li>
                    }
                }
            </ul>
        </div>
    }

    <!-- Табы для выбора способа создания -->
    <ul class="nav nav-tabs mb-3" id="createMethodTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="form-tab" data-bs-toggle="tab" data-bs-target="#form-content" type="button" role="tab">
                📋 Конструктор вопросов
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="json-tab" data-bs-toggle="tab" data-bs-target="#json-content" type="button" role="tab">
                {"<>"} JSON текст
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="file-tab" data-bs-toggle="tab" data-bs-target="#file-content" type="button" role="tab">
                📁 Загрузка файла
            </button>
        </li>
    </ul>

    <div class="tab-content" id="createMethodTabsContent">
        <!-- Конструктор вопросов -->
        <div class="tab-pane fade show active" id="form-content" role="tabpanel">
            <div class="card">
                <div class="card-header">
                    <h5>Добавление вопросов</h5>
                </div>
                <div class="card-body">
                    <div id="questionsContainer">
                        <!-- Вопросы будут добавляться сюда -->
                    </div>
                    <button type="button" class="btn btn-primary mt-3" onclick="addQuestion()">
                        <i class="bi bi-plus-circle"></i> Добавить вопрос
                    </button>
                </div>
            </div>
        </div>

        <!-- JSON текст -->
        <div class="tab-pane fade" id="json-content" role="tabpanel">
            <div class="mb-3">
                <label class="form-label">Вставьте JSON с вопросами теста</label>
                <textarea class="form-control" name="JsonContent" id="jsonContent" rows="15" placeholder='{"TestTitle": "Название теста", "Questions": [...]}'></textarea>
                <small class="text-muted">Формат JSON должен соответствовать структуре TestModel</small>
            </div>
        </div>

        <!-- Загрузка файла -->
        <div class="tab-pane fade" id="file-content" role="tabpanel">
            <div class="mb-3">
                <label asp-for="File" class="form-label">JSON файл теста</label>
                <input asp-for="File" type="file" class="form-control" accept=".json" />
                <span asp-validation-for="File" class="text-danger"></span>
                <small class="text-muted">Загрузите готовый JSON файл с вопросами теста</small>
            </div>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data" id="createForm">
        <input type="hidden" name="SectionId" value="@Model.SectionId" />
        
        <div class="mb-3 mt-3">
            <label asp-for="Name" class="form-label">Название теста *</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SectionId" class="form-label">Раздел</label>
            <select asp-for="SectionId" class="form-select">
                <option value="">-- Без раздела --</option>
                @if (Model.Sections != null)
                {
                    @foreach (var sec in Model.Sections)
                    {
                        <option value="@sec.Id">@sec.Name</option>
                    }
                }
            </select>
        </div>

        <!-- Скрытое поле для хранения вопросов из конструктора -->
        <input type="hidden" name="Questions" id="questionsHidden" />

        <div class="mb-3">
            <button type="submit" class="btn btn-success">Сохранить</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Отмена</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
    <script>
        let questionCounter = 0;
        
        function addQuestion() {
            questionCounter++;
            const container = document.getElementById('questionsContainer');
            const questionHtml = `
                <div class="card mb-3 question-card" id="question-${questionCounter}">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Вопрос #${questionCounter}</span>
                        <button type="button" class="btn btn-sm btn-danger" onclick="removeQuestion(${questionCounter})">
                            <i class="bi bi-trash"></i> Удалить
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Тип вопроса</label>
                            <select class="form-select question-type" onchange="updateQuestionType(${questionCounter})">
                                <option value="multiple_choice">Один правильный ответ</option>
                                <option value="multiple_select">Несколько правильных ответов</option>
                                <option value="matching">Соответствие</option>
                                <option value="fill_in">Ввод текста</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Текст вопроса</label>
                            <textarea class="form-control question-text" rows="2"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Объяснение (пояснение к ответу)</label>
                            <textarea class="form-control question-explanation" rows="2"></textarea>
                        </div>
                        
                        <!-- Опции для multiple_choice и multiple_select -->
                        <div class="options-container" id="options-${questionCounter}">
                            <label class="form-label">Варианты ответов</label>
                            <div class="option-item mb-2">
                                <input type="text" class="form-control option-text mb-2" placeholder="Вариант ответа">
                                <div class="form-check">
                                    <input class="form-check-input correct-answer" type="radio" name="correct-${questionCounter}">
                                    <label class="form-check-label">Правильный ответ</label>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addOption(${questionCounter})">
                                + Добавить вариант
                            </button>
                        </div>
                        
                        <!-- Поля для matching -->
                        <div class="matching-container d-none" id="matching-${questionCounter}">
                            <label class="form-label">Элементы для соответствия</label>
                            <div class="row">
                                <div class="col-md-6">
                                    <label>Левая колонка</label>
                                    <div class="matching-item mb-2">
                                        <input type="text" class="form-control matching-left" placeholder="Элемент слева">
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addMatchingLeft(${questionCounter})">+ Добавить</button>
                                </div>
                                <div class="col-md-6">
                                    <label>Правая колонка</label>
                                    <div class="matching-item mb-2">
                                        <input type="text" class="form-control matching-right" placeholder="Элемент справа">
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addMatchingRight(${questionCounter})">+ Добавить</button>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Поля для fill_in -->
                        <div class="fillin-container d-none" id="fillin-${questionCounter}">
                            <label class="form-label">Правильные ответы (через запятую)</label>
                            <input type="text" class="form-control fillin-answers" placeholder="ответ1, ответ2, ответ3">
                        </div>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', questionHtml);
        }
        
        function removeQuestion(id) {
            document.getElementById(`question-${id}`).remove();
        }
        
        function updateQuestionType(id) {
            const card = document.getElementById(`question-${id}`);
            const type = card.querySelector('.question-type').value;
            
            card.querySelector('.options-container').classList.toggle('d-none', 
                type !== 'multiple_choice' && type !== 'multiple_select');
            card.querySelector('.matching-container').classList.toggle('d-none', type !== 'matching');
            card.querySelector('.fillin-container').classList.toggle('d-none', type !== 'fill_in');
        }
        
        function addOption(questionId) {
            const container = document.getElementById(`options-${questionId}`);
            const type = document.querySelector(`#question-${questionId} .question-type`).value;
            const inputType = type === 'multiple_choice' ? 'radio' : 'checkbox';
            const nameAttr = type === 'multiple_choice' ? `name="correct-${questionId}"` : '';
            
            const html = `
                <div class="option-item mb-2">
                    <input type="text" class="form-control option-text mb-2" placeholder="Вариант ответа">
                    <div class="form-check">
                        <input class="form-check-input correct-answer" type="${inputType}" ${nameAttr}>
                        <label class="form-check-label">Правильный ответ</label>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', html);
        }
        
        function addMatchingLeft(questionId) {
            const container = document.getElementById(`matching-${questionId}`);
            const html = `
                <div class="matching-item mb-2">
                    <input type="text" class="form-control matching-left" placeholder="Элемент слева">
                </div>
            `;
            container.querySelector('.col-md-6').insertAdjacentHTML('beforeend', html);
        }
        
        function addMatchingRight(questionId) {
            const container = document.getElementById(`matching-${questionId}`);
            const html = `
                <div class="matching-item mb-2">
                    <input type="text" class="form-control matching-right" placeholder="Элемент справа">
                </div>
            `;
            container.querySelectorAll('.col-md-6')[1].insertAdjacentHTML('beforeend', html);
        }
        
        // Сбор данных формы перед отправкой
        document.getElementById('createForm').addEventListener('submit', function(e) {
            const activeTab = document.querySelector('#createMethodTabs .nav-link.active').id;
            
            if (activeTab === 'form-tab') {
                e.preventDefault();
                
                const questions = [];
                document.querySelectorAll('.question-card').forEach(card => {
                    const type = card.querySelector('.question-type').value;
                    const question = {
                        Type: type,
                        Text: card.querySelector('.question-text').value,
                        Explanation: card.querySelector('.question-explanation').value
                    };
                    
                    if (type === 'multiple_choice' || type === 'multiple_select') {
                        const options = [];
                        const correctAnswers = [];
                        card.querySelectorAll('.option-item').forEach(item => {
                            const text = item.querySelector('.option-text').value;
                            if (text) {
                                options.push(text);
                                const isCorrect = item.querySelector('.correct-answer').checked;
                                correctAnswers.push(isCorrect);
                            }
                        });
                        question.Options = options;
                        question.CorrectAnswers = correctAnswers;
                    } else if (type === 'matching') {
                        question.LeftItems = Array.from(card.querySelectorAll('.matching-left')).map(i => i.value).filter(v => v);
                        question.RightItems = Array.from(card.querySelectorAll('.matching-right')).map(i => i.value).filter(v => v);
                    } else if (type === 'fill_in') {
                        question.CorrectAnswersList = card.querySelector('.fillin-answers').value.split(',').map(s => s.trim()).filter(s => s);
                    }
                    
                    if (question.Text) {
                        questions.push(question);
                    }
                });
                
                if (questions.length === 0) {
                    alert('Добавьте хотя бы один вопрос!');
                    return;
                }
                
                // Создаем скрытые поля для отправки вопросов
                questions.forEach((q, index) => {
                    const prefix = `Questions[${index}]`;
                    
                    const createInput = (name, value) => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = `${prefix}.${name}`;
                        input.value = value;
                        document.getElementById('createForm').appendChild(input);
                    };
                    
                    createInput('Type', q.Type);
                    createInput('Text', q.Text);
                    createInput('Explanation', q.Explanation || '');
                    
                    if (q.Options) {
                        q.Options.forEach((opt, i) => createInput(`Options[${i}]`, opt));
                    }
                    if (q.CorrectAnswers) {
                        q.CorrectAnswers.forEach((ca, i) => createInput(`CorrectAnswers[${i}]`, ca));
                    }
                    if (q.LeftItems) {
                        q.LeftItems.forEach((item, i) => createInput(`LeftItems[${i}]`, item));
                    }
                    if (q.RightItems) {
                        q.RightItems.forEach((item, i) => createInput(`RightItems[${i}]`, item));
                    }
                    if (q.CorrectAnswersList) {
                        q.CorrectAnswersList.forEach((ca, i) => createInput(`CorrectAnswersList[${i}]`, ca));
                    }
                });
                
                this.submit();
            }
        });
    </script>
}