@model EnglishTestPlatform.ViewModel.TheoryViewModel
@{
    ViewData["Title"] = "Редактировать теорию";
}

@section Styles {
    <link rel="stylesheet" href="~/css/visual-table-editor.css" />
}

<div class="container mt-4">
    <h1>✏️ Редактировать теорию</h1>
    <hr />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ✅ ФОРМА ОБЁРТЫВАЕТ ВСЁ СОДЕРЖИМОЕ -->
    <form method="post" enctype="multipart/form-data" id="editForm">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ExistingFileId" />

        <!-- Табы для выбора способа редактирования -->
        <ul class="nav nav-tabs mb-3" id="editMethodTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="editor-tab" data-bs-toggle="tab" data-bs-target="#editor-content" type="button" role="tab">
                    ✏️ Редактор Markdown
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="file-tab" data-bs-toggle="tab" data-bs-target="#file-content" type="button" role="tab">
                    📁 Загрузка файла
                </button>
            </li>
        </ul>

        <div class="tab-content" id="editMethodTabsContent">
            <!-- Редактор Markdown -->
            <div class="tab-pane fade show active" id="editor-content" role="tabpanel">
                <div class="row">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5>✏️ Ввод Markdown</h5>
                            </div>
                            <div class="card-body">
                                <!-- Панель инструментов -->
                                <div class="toolbar mb-2 p-2 border rounded bg-light">
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-command="bold" title="Полужирный (Ctrl+B)">
                                        <strong>B</strong>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-command="italic" title="Курсив (Ctrl+I)">
                                        <em>I</em>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-command="underline" title="Подчеркнутый (Ctrl+U)">
                                        <u>U</u>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-command="strikeThrough" title="Зачеркнутый (Ctrl+S)">
                                        <s>S</s>
                                    </button>
                                    <span class="border-start mx-1"></span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-command="heading1" title="Заголовок 1 (Ctrl+Alt+1)">
                                        H1
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-command="heading2" title="Заголовок 2 (Ctrl+Alt+2)">
                                        H2
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-command="heading3" title="Заголовок 3 (Ctrl+Alt+3)">
                                        H3
                                    </button>
                                    <span class="border-start mx-1"></span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-command="unorderedList" title="Маркированный список (Ctrl+Shift+8)">
                                        • Список
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-command="orderedList" title="Нумерованный список (Ctrl+Shift+7)">
                                        1. Список
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-command="blockquote" title="Цитата (Ctrl+Shift+Q)">
                                        ❝ Цитата
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-command="codeBlock" title="Блок кода (Ctrl+Shift+C)">
                                        &lt;/&gt; Код
                                    </button>
                                    <span class="border-start mx-1"></span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-command="table" title="Вставить таблицу">
                                        📊 Таблица
                                    </button>
                                    <span class="border-start mx-1"></span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-command="link" title="Вставить ссылку (Ctrl+K)">
                                        🔗 Ссылка
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-command="image" title="Вставить изображение (Ctrl+Shift+I)">
                                        🖼️ Картинка
                                    </button>
                                    <span class="border-start mx-1"></span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-command="undo" title="Отменить (Ctrl+Z)">
                                        ↩️
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-command="redo" title="Повторить (Ctrl+Y)">
                                        ↪️
                                    </button>
                                </div>
                                <!-- Контекстное меню -->
                                <div id="contextMenu" class="dropdown-menu position-absolute shadow-lg" style="display: none; z-index: 1000;">
                                    <a class="dropdown-item" href="#" data-command="bold"><strong>Полужирный</strong> <small class="text-muted">(Ctrl+B)</small></a>
                                    <a class="dropdown-item" href="#" data-command="italic"><em>Курсив</em> <small class="text-muted">(Ctrl+I)</small></a>
                                    <a class="dropdown-item" href="#" data-command="underline"><u>Подчеркнутый</u> <small class="text-muted">(Ctrl+U)</small></a>
                                    <a class="dropdown-item" href="#" data-command="strikeThrough"><s>Зачеркнутый</s> <small class="text-muted">(Ctrl+S)</small></a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" href="#" data-command="heading1">Заголовок 1 <small class="text-muted">(Ctrl+Alt+1)</small></a>
                                    <a class="dropdown-item" href="#" data-command="heading2">Заголовок 2 <small class="text-muted">(Ctrl+Alt+2)</small></a>
                                    <a class="dropdown-item" href="#" data-command="heading3">Заголовок 3 <small class="text-muted">(Ctrl+Alt+3)</small></a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" href="#" data-command="unorderedList">• Маркированный список <small class="text-muted">(Ctrl+Shift+8)</small></a>
                                    <a class="dropdown-item" href="#" data-command="orderedList">1. Нумерованный список <small class="text-muted">(Ctrl+Shift+7)</small></a>
                                    <a class="dropdown-item" href="#" data-command="blockquote">❝ Цитата <small class="text-muted">(Ctrl+Shift+Q)</small></a>
                                    <a class="dropdown-item" href="#" data-command="codeBlock">&lt;/&gt; Блок кода <small class="text-muted">(Ctrl+Shift+C)</small></a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" href="#" data-command="link">🔗 Вставить ссылку <small class="text-muted">(Ctrl+K)</small></a>
                                    <a class="dropdown-item" href="#" data-command="image">🖼️ Вставить изображение <small class="text-muted">(Ctrl+Shift+I)</small></a>
                                </div>
                                <!-- Редактируемая область с contenteditable -->
                                <div id="markdownEditor" class="form-control markdown-editor" contenteditable="true"
                                     style="min-height: 400px; max-height: 600px; overflow-y: auto; font-family: 'Consolas', monospace; font-size: 14px; line-height: 1.6;"
                                     placeholder="# Заголовок&#10;&#10;Ваш текст в формате Markdown...">@Model.MarkdownContent</div>
                                <!-- Скрытое поле для отправки данных -->
                                <input type="hidden" name="MarkdownContent" id="hiddenMarkdownContent" value="@Model.MarkdownContent" />
                                <span asp-validation-for="MarkdownContent" class="text-danger"></span>
                                <!-- Подсказки по горячим клавишам -->
                                <div class="mt-2 p-2 bg-light border rounded small">
                                    <strong class="text-primary">⌨️ Горячие клавиши:</strong>
                                    <span class="ms-2"><kbd>Ctrl+B</kbd> Жирный</span>
                                    <span class="ms-2"><kbd>Ctrl+I</kbd> Курсив</span>
                                    <span class="ms-2"><kbd>Ctrl+U</kbd> Подчеркнутый</span>
                                    <span class="ms-2"><kbd>Ctrl+K</kbd> Ссылка</span>
                                    <span class="ms-2"><kbd>Ctrl+Shift+C</kbd> Код</span>
                                    <span class="ms-2"><kbd>Ctrl+Z</kbd> Отменить</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5>👁️ Предпросмотр</h5>
                            </div>
                            <div class="card-body">
                                <div id="markdownPreview" class="markdown-body" style="max-height: 500px; overflow-y: auto;">
                                    <p class="text-muted">Здесь будет предпросмотр вашего Markdown...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Загрузка файла -->
            <div class="tab-pane fade" id="file-content" role="tabpanel">
                <div class="mb-3">
                    <label class="form-label">Текущий файл</label>
                    <div class="alert alert-info">
                        <strong>@Model.Name</strong><br />
                        <small>Файл уже загружен и сохранён в системе</small>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="File" class="form-label">Заменить файл Markdown (.md)</label>
                    <input asp-for="File" type="file" class="form-control" accept=".md" />
                    <span asp-validation-for="File" class="text-danger"></span>
                    <small class="text-muted">Выберите новый MD файл, ТОЛЬКО если хотите заменить текущий. Оставьте пустым, чтобы сохранить существующий файл.</small>
                </div>
            </div>
        </div>

        <!-- Поля названия и раздела -->
        <div class="mb-3 mt-3">
            <label asp-for="Name" class="form-label">Название теории *</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SectionId" class="form-label">Раздел</label>
            <select asp-for="SectionId" class="form-select">
                <option value="">-- Без раздела --</option>
                @if (Model.Sections != null)
                {
                    @foreach (var sec in Model.Sections)
                    {
                        @if (Model.SectionId == sec.Id)
                        {
                            <option value="@sec.Id" selected>@sec.Name</option>
                        }
                        else
                        {
                            <option value="@sec.Id">@sec.Name</option>
                        }
                    }
                }
            </select>
            <span asp-validation-for="SectionId" class="text-danger"></span>
        </div>

        <!-- Кнопки отправки -->
        <div class="mb-3">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Сохранить изменения
            </button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Отмена
            </a>
        </div>
    </form>

    <!-- Блок предупреждений -->
    <div class="card bg-warning bg-opacity-10 mt-3">
        <div class="card-header">
            <strong>⚠️ Внимание:</strong>
        </div>
        <div class="card-body">
            <ul class="mb-0">
                <li>Если вы не выбираете новый файл и не редактируете контент, существующий файл остаётся без изменений</li>
                <li>При загрузке нового файла старый будет удалён</li>
                <li>Убедитесь, что новый MD файл имеет правильную структуру Markdown</li>
                <li>Название теории можно менять независимо от файла</li>
            </ul>
        </div>
    </div>

    <!-- Блок ошибок валидации (после формы) -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mt-3">
            <strong>Ошибки валидации:</strong>
            <ul>
                @foreach (var key in ViewData.ModelState.Keys)
                {
                    foreach (var error in ViewData.ModelState[key].Errors)
                    {
                        <li>@key: @error.ErrorMessage</li>
                    }
                }
            </ul>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        let previewTimeout;
        let isSyncing = false;
        let contextMenuVisible = false;

        // Получаем элементы
        const editor = document.getElementById('markdownEditor');
        const hiddenField = document.getElementById('hiddenMarkdownContent');
        const contextMenu = document.getElementById('contextMenu');
        const toolbarButtons = document.querySelectorAll('.toolbar button[data-command]');
        const contextMenuItems = document.querySelectorAll('#contextMenu a[data-command]');

        // Функция обновления скрытого поля перед отправкой формы
        function updateHiddenField() {
            if (!editor)
                return;
            hiddenField.value = getEditorMarkdown();
        }

        // Функция предпросмотра
        function updatePreview() {
            clearTimeout(previewTimeout);
            previewTimeout = setTimeout(async () => {
                // Получаем контент через интеграцию таблиц для корректной конвертации
                updateHiddenField();
                let markdownContent;
                if (window.tableEditorIntegration) {
                    markdownContent =
                        window.tableEditorIntegration
                        .getContent();
                }
                else {
                    markdownContent =
                        hiddenField.value;
                }

                const previewDiv = document.getElementById('markdownPreview');

                if (!markdownContent.trim()) {
                    previewDiv.innerHTML = '<p class="text-muted">Здесь будет предпросмотр вашего Markdown...</p>';
                    return;
                }

                try {
                    const response = await fetch('@Url.Action("Preview", "TheoryAdmin")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: `markdownContent=${encodeURIComponent(markdownContent)}`
                    });

                    const html = await response.text();
                    previewDiv.innerHTML = html || '<p class="text-muted">Пустой контент</p>';
                    if(
                       window.visualTableEditor
                    ){
                       window.visualTableEditor.init();
                    }

                    // После обновления предпросмотра инициализируем визуальный редактор таблиц
                    setTimeout(() => {
                        if (window.visualTableEditor) {
                            window.visualTableEditor.scanTables();
                        }
                    }, 100);
                } catch (error) {
                    previewDiv.innerHTML = `<div class="alert alert-danger">Ошибка загрузки предпросмотра: ${error.message}</div>`;
                }
            }, 500);
        }

        function getEditorMarkdown() {
            let text = '';

            // Проходим по всем дочерним узлам редактора
            const processNode = (node) => {
                if (node.nodeType === Node.TEXT_NODE) {
                    text += node.textContent;
                    return;
                }

                if (node.nodeType === Node.ELEMENT_NODE) {
                    // Если это таблица - конвертируем в Markdown
                    if (node.nodeName === 'TABLE' || node.tagName === 'TABLE') {
                        if (window.tableEditorIntegration && window.tableEditorIntegration.visualEditor) {
                            text += window.tableEditorIntegration.visualEditor.tableToMarkdown(node);
                            text += '\n\n';
                            return;
                        }
                    }

                    // Для других элементов получаем текстовое содержимое
                    if (node.nodeName === 'BR') {
                        text += '\n';
                        return;
                    }

                    if (node.nodeName === 'DIV' || node.nodeName === 'P') {
                        text += node.innerText || node.textContent || '';
                        text += '\n\n';
                        return;
                    }

                    // Рекурсивно обрабатываем дочерние узлы
                    if (node.childNodes && node.childNodes.length > 0) {
                        Array.from(node.childNodes).forEach(child => processNode(child));
                        // Добавляем перенос строки после блочных элементов
                        if (['DIV', 'P', 'TABLE', 'UL', 'OL', 'BLOCKQUOTE', 'PRE'].includes(node.nodeName)) {
                            text += '\n';
                        }
                    } else {
                        text += node.innerText || node.textContent || '';
                    }
                }
            };

            Array.from(editor.childNodes).forEach(node => processNode(node));

            // Очищаем множественные переносы строк
            return text
                .replace(/\n{3,}/g, '\n\n')
                .trim();
        }
        // Применение форматирования к выделенному тексту
        function applyCommand(command, value = null) {
            editor.focus();

            switch(command) {
                case 'bold':
                    document.execCommand('bold', false, value);
                    wrapWithMarkdown('**');
                    break;
                case 'italic':
                    document.execCommand('italic', false, value);
                    wrapWithMarkdown('*');
                    break;
                case 'underline':
                    document.execCommand('underline', false, value);
                    wrapWithMarkdown('__');
                    break;
                case 'strikeThrough':
                    document.execCommand('strikeThrough', false, value);
                    wrapWithMarkdown('~~');
                    break;
                case 'heading1':
                    formatHeading('# ');
                    break;
                case 'heading2':
                    formatHeading('## ');
                    break;
                case 'heading3':
                    formatHeading('### ');
                    break;
                case 'unorderedList':
                    formatList('- ');
                    break;
                case 'orderedList':
                    formatList('1. ');
                    break;
                case 'blockquote':
                    formatBlockquote('> ');
                    break;
                case 'codeBlock':
                    wrapWithMarkdown('`', '`');
                    break;
                case 'table':
                    insertTable();
                    break;
                case 'link':
                    insertLink();
                    break;
                case 'image':
                    insertImage();
                    break;
                case 'undo':
                    document.execCommand('undo', false, value);
                    break;
                case 'redo':
                    document.execCommand('redo', false, value);
                    break;
                default:
                    document.execCommand(command, false, value);
            }

            updateHiddenField();
            updatePreview();
        }

        // Обертка текста маркерами Markdown
        function wrapWithMarkdown(prefix, suffix = null) {
            const selection = window.getSelection();
            if (!selection.rangeCount) return;

            const range = selection.getRangeAt(0);
            const selectedText = range.toString();

            if (selectedText.length > 0) {
                suffix = suffix || prefix;
                const wrappedText = prefix + selectedText + suffix;
                document.execCommand('insertText', false, wrappedText);
            } else {
                // Если текст не выделен, вставляем шаблоны
                suffix = suffix || prefix;
                const template = prefix + 'текст' + suffix;
                document.execCommand('insertText', false, template);

                // Выделяем "текст" для замены
                setTimeout(() => {
                    const newSelection = window.getSelection();
                    if (newSelection.rangeCount) {
                        const newRange = newSelection.getRangeAt(0);
                        // Пытаемся выделить только中间的 текст
                        const currentText = newRange.toString();
                        if (currentText.includes('текст')) {
                            // Упрощенная логика - пользователь сам заменит
                        }
                    }
                }, 10);
            }
        }

        // Форматирование заголовков
        function formatHeading(prefix) {
            const selection = window.getSelection();
            if (!selection.rangeCount) return;

            const range = selection.getRangeAt(0);
            let node = range.startContainer;

            // Находим родительский элемент строки
            while (node && node.nodeType !== 1) {
                node = node.parentNode;
            }

            if (node) {
                const text = node.textContent || node.innerText;
                const lines = text.split('\n');
                const currentLineIndex = getCurrentLineIndex(range);

                if (currentLineIndex >= 0 && currentLineIndex < lines.length) {
                    const currentLine = lines[currentLineIndex];
                    if (!currentLine.startsWith(prefix)) {
                        lines[currentLineIndex] = prefix + currentLine;
                        node.textContent = lines.join('\n');
                    }
                }
            }
        }

        // Получение индекса текущей строки
        function getCurrentLineIndex(range) {
            const editorRect = editor.getBoundingClientRect();
            const rangeRect = range.getClientRects()[0];

            if (rangeRect) {
                const lineHeight = 22; // Примерная высота строки
                const relativeY = rangeRect.top - editorRect.top + editor.scrollTop;
                return Math.floor(relativeY / lineHeight);
            }
            return 0;
        }

        // Форматирование списков
                function formatList(prefix) {
            const selection = window.getSelection();

            if (!selection.rangeCount)
                return;

            const selectedText = selection.toString();

            if (selectedText.trim()) {

                const lines = selectedText
                    .split(/\r?\n/)
                    .filter(x => x.trim());

                const formatted = lines.map((line, index) => {

                    if (prefix === '1. ')
                        return `${index + 1}. ${line.trim()}`;

                    return `- ${line.trim()}`;

                }).join('\n');

                document.execCommand(
                    'insertText',
                    false,
                    formatted
                );

            }
            else {

                document.execCommand(
                    'insertText',
                    false,
                    prefix
                );

            }

            updateHiddenField();
            updatePreview();
        }

        // Форматирование цитат
        function formatBlockquote(prefix) {
            const selection = window.getSelection();
            if (!selection.rangeCount) return;

            const range = selection.getRangeAt(0);
            let node = range.startContainer;

            while (node && node.nodeType !== 1) {
                node = node.parentNode;
            }

            if (node) {
                const text = node.textContent || node.innerText;
                const lines = text.split('\n');
                const currentLineIndex = getCurrentLineIndex(range);

                if (currentLineIndex >= 0 && currentLineIndex < lines.length) {
                    const currentLine = lines[currentLineIndex].trim();
                    if (!currentLine.startsWith(prefix)) {
                        lines[currentLineIndex] = prefix + currentLine;
                        node.textContent = lines.join('\n');
                    }
                }
            }
        }

        // Вставка ссылки
        function insertLink() {
            const url = prompt('Введите URL ссылки:', 'https://');
            if (url) {
                const selection = window.getSelection();
                const selectedText = selection.toString() || 'ссылка';
                const markdownLink = `[${selectedText}](${url})`;
                document.execCommand('insertText', false, markdownLink);
            }
        }

        // Вставка изображения
        function insertImage() {
            const url = prompt('Введите URL изображения:', 'https://');
            if (url) {
                const markdownImage = `![Описание изображения](${url})`;
                document.execCommand('insertText', false, markdownImage);
            }
        }

        // Вставка таблицы Markdown с интерактивным управлением
        function insertTable() {
            const rows =
                parseInt(
                    prompt(
                        'Количество строк',
                        '3'
                    )
                ) || 3;
            const cols =
                parseInt(
                    prompt(
                        'Количество столбцов',
                        '3'
                    )
                ) || 3;

            // Создаём HTML таблицу напрямую в редакторе
            let html = '<table class="table table-bordered visual-table" style="border-collapse: collapse; width: 100%; margin: 10px 0;">';

            // Заголовок
            html += '<tr>';
            for(let c = 0; c < cols; c++) {
                html += '<th contenteditable="true" style="border: 1px solid #dee2e6; padding: 8px; outline: none; min-width: 50px;"></th>';
            }
            html += '</tr>';

            // Строки данных
            for(let r = 1; r < rows; r++) {
                html += '<tr>';
                for(let c = 0; c < cols; c++) {
                    html += '<td contenteditable="true" style="border: 1px solid #dee2e6; padding: 8px; outline: none; min-width: 50px;"></td>';
                }
                html += '</tr>';
            }

            html += '</table>\n';

            document.execCommand('insertHTML', false, html);

            updateHiddenField();
            updatePreview();

            // Переинициализируем визуальный редактор после вставки таблицы
            setTimeout(() => {
                if (window.tableEditorIntegration) {
                    window.tableEditorIntegration.visualEditor.scanTables();
                }
            }, 300);
        }

        // Обработчики кнопок панели инструментов
        toolbarButtons.forEach(button => {
            button.addEventListener('click', (e) => {
                e.preventDefault();
                const command = button.getAttribute('data-command');
                applyCommand(command);
            });
        });

        // Обработчики пунктов контекстного меню
        contextMenuItems.forEach(item => {
            item.addEventListener('click', (e) => {
                e.preventDefault();
                const command = item.getAttribute('data-command');
                applyCommand(command);
                hideContextMenu();
            });
        });

        // Показ контекстного меню при правом клике
        editor.addEventListener('contextmenu', (e) => {
            e.preventDefault();

            const selection = window.getSelection();
            const selectedText = selection.toString().trim();

            // Проверяем, находится ли курсор внутри таблицы
            const target = e.target;
            const tableContext = findTableContext(target);

            if (tableContext) {
                // Показываем контекстное меню для таблиц
                // tableContext уже содержит { table, rowIndex, cellIndex }
                if (window.tableEditorIntegration && window.tableEditorIntegration.visualEditor) {
                    window.tableEditorIntegration.visualEditor.showTableContextMenu(
                        e,
                        tableContext.table,
                        tableContext.rowIndex,
                        tableContext.cellIndex
                    );
                }
            } else if (selectedText.length > 0) {
                showContextMenu(e.pageX, e.pageY);
            }
        });

        // Функция для поиска контекста таблицы
        function findTableContext(target) {
            // Проверяем, является ли target ячейкой таблицы
            let cell = target;

            // Поднимаемся по DOM, пока не найдем td/th или table
            while (cell && cell !== editor) {
                if (cell.tagName === 'TD' || cell.tagName === 'TH') {
                    // Нашли ячейку таблицы
                    const row = cell.parentElement;
                    const table = row.closest('table');

                    if (table) {
                        const rows = Array.from(table.querySelectorAll('tr'));
                        const rowIndex = rows.indexOf(row);
                        const cells = Array.from(row.querySelectorAll('td, th'));
                        const cellIndex = cells.indexOf(cell);

                        return {
                            table: table,
                            rowIndex: rowIndex,
                            cellIndex: cellIndex
                        };
                    }
                }

                if (cell.tagName === 'TABLE') {
                    // Кликнули прямо на таблицу, но не на ячейку
                    // Возвращаем контекст с нулевыми индексами
                    return {
                        table: cell,
                        rowIndex: 0,
                        cellIndex: 0
                    };
                }

                cell = cell.parentElement;
            }

            return null;
        }

        // Показать контекстное меню
        function showContextMenu(x, y) {
            contextMenu.style.display = 'block';
            contextMenu.style.left = x + 'px';
            contextMenu.style.top = y + 'px';
            contextMenuVisible = true;

            // Проверяем, чтобы меню не выходило за пределы экрана
            const rect = contextMenu.getBoundingClientRect();
            if (rect.right > window.innerWidth) {
                contextMenu.style.left = (x - rect.width) + 'px';
            }
            if (rect.bottom > window.innerHeight) {
                contextMenu.style.top = (y - rect.height) + 'px';
            }
        }

        // Скрыть контекстное меню
        function hideContextMenu() {
            contextMenu.style.display = 'none';
            contextMenuVisible = false;
        }

        // Закрытие меню при клике вне его
        document.addEventListener('click', (e) => {
            if (contextMenuVisible && !contextMenu.contains(e.target)) {
                hideContextMenu();
            }
        });

        // Горячие клавиши
        editor.addEventListener('keydown', (e) => {
            // Ctrl+B - жирный
            if (e.ctrlKey && e.key === 'b') {
                e.preventDefault();
                applyCommand('bold');
            }
            // Ctrl+I - курсив
            if (e.ctrlKey && e.key === 'i') {
                e.preventDefault();
                applyCommand('italic');
            }
            // Ctrl+U - подчеркнутый
            if (e.ctrlKey && e.key === 'u') {
                e.preventDefault();
                applyCommand('underline');
            }
            // Ctrl+S - зачеркнутый
            if (e.ctrlKey && e.key === 's') {
                e.preventDefault();
                applyCommand('strikeThrough');
            }
            // Ctrl+K - ссылка
            if (e.ctrlKey && e.key === 'k') {
                e.preventDefault();
                applyCommand('link');
            }
            // Ctrl+Z - отменить
            if (e.ctrlKey && e.key === 'z') {
                // Не предотвращаем, пусть работает стандартное поведение
            }
            // Ctrl+Y - повторить
            if (e.ctrlKey && e.key === 'y') {
                // Не предотвращаем, пусть работает стандартное поведение
            }
            // Ctrl+Shift+C - код
            if (e.ctrlKey && e.shiftKey && e.key === 'C') {
                e.preventDefault();
                applyCommand('codeBlock');
            }
            // Ctrl+Shift+8 - маркированный список
            if (e.ctrlKey && e.shiftKey && e.key === '8') {
                e.preventDefault();
                applyCommand('unorderedList');
            }
            // Ctrl+Shift+7 - нумерованный список
            if (e.ctrlKey && e.shiftKey && e.key === '7') {
                e.preventDefault();
                applyCommand('orderedList');
            }
            // Ctrl+Shift+Q - цитата
            if (e.ctrlKey && e.shiftKey && e.key === 'Q') {
                e.preventDefault();
                applyCommand('blockquote');
            }
            // Ctrl+Shift+I - изображение
            if (e.ctrlKey && e.shiftKey && e.key === 'I') {
                e.preventDefault();
                applyCommand('image');
            }
            // Ctrl+Alt+1 - заголовок 1
            if (e.ctrlKey && e.altKey && e.key === '1') {
                e.preventDefault();
                applyCommand('heading1');
            }
            // Ctrl+Alt+2 - заголовок 2
            if (e.ctrlKey && e.altKey && e.key === '2') {
                e.preventDefault();
                applyCommand('heading2');
            }
            // Ctrl+Alt+3 - заголовок 3
            if (e.ctrlKey && e.altKey && e.key === '3') {
                e.preventDefault();
                applyCommand('heading3');
            }
            if (e.key === 'Enter') {
                const text = getEditorMarkdown()
                const lines = text.split(/\r?\n/);
                const sel = window.getSelection();

                if (!sel.rangeCount)
                    return;

                const current = sel.anchorNode?.textContent || '';

                if (current.trim().startsWith('- ')) {
                    e.preventDefault();
                    document.execCommand(
                        'insertText',
                        false,
                        '\n- '
                    );
                }
            }
        });

        let typingTimer;
        // Обновление скрытого поля при изменении контента
        editor.addEventListener(
           "input",
           ()=>{
              clearTimeout(
                  typingTimer
              );
              updateHiddenField();
              typingTimer=
                 setTimeout(
                    ()=>{
                    updatePreview();
                 },300);
           });

        // Слушаем изменения в редакторе (дублирующий listener можно удалить)
        // editor.addEventListener('input', updatePreview);

        // Синхронизация прокрутки между редактором и предпросмотром
        function syncScroll(source, target) {
            if (isSyncing) return;
            isSyncing = true;

            const scrollPercentage = source.scrollTop / (source.scrollHeight - source.clientHeight);
            target.scrollTop = scrollPercentage * (target.scrollHeight - target.clientHeight);

            setTimeout(() => { isSyncing = false; }, 50);
        }

        const preview = document.getElementById('markdownPreview');

        editor.addEventListener('scroll', function() {
            syncScroll(editor, preview);
        });

        preview.addEventListener('scroll', function() {
            syncScroll(preview, editor);
        });

        // Обработка отправки формы
        document.getElementById('editForm').addEventListener('submit', function(e) {
            const activeTab = document.querySelector('#editMethodTabs .nav-link.active').id;

            if (activeTab === 'editor-tab') {
                // Получаем контент через интеграцию таблиц для корректной конвертации
                updateHiddenField();

                let markdownContent;

                if (window.tableEditorIntegration) {
                    markdownContent = window.tableEditorIntegration.getContent();
                }
                else {
                    markdownContent = hiddenField.value;
                }

                if (!markdownContent.trim()) {
                    e.preventDefault();
                    alert('Введите контент в редакторе Markdown!');
                    return;
                }
                updateHiddenField(); // Обновляем скрытое поле перед отправкой
            }
        });

        // Инициализация при загрузке
        document.addEventListener('DOMContentLoaded', function() {
            if (!editor.textContent.trim()) {
                editor.innerHTML = '';
            }
            updateHiddenField();

            // Инициализируем редактор таблиц с задержкой
            setTimeout(() => {
                initTableEditorIntegration();

                // Принудительно конвертируем существующие Markdown таблицы
                if (window.tableEditorIntegration) {
                    window.tableEditorIntegration.convertExistingMarkdownToHtml();
                    updatePreview();
                }
            }, 500);
        });

        // Callback при изменении таблицы (оставлен для совместимости)
        function onTableChange(table) {
            updateHiddenField();
            updatePreview();
        }
    </script>

    <script src="~/js/visual-table-editor.js"></script>
    <script>
        // Интеграция визуального редактора таблиц с основным редактором
        class TableEditorIntegration {
            constructor(editorId, previewId, hiddenFieldId, onChangeCallback) {
                this.editor = document.getElementById(editorId);
                this.preview = document.getElementById(previewId);
                this.hiddenField = document.getElementById(hiddenFieldId);
                this.onChange = onChangeCallback;
                this.visualEditor = null;
                this.isProcessing = false;

                this.init();
            }

            init() {

                // Инициализируем визуальный редактор
                this.visualEditor = new VisualTableEditor(this.editor.id, () => {
                    this.onTableModified();
                });
            }

            convertExistingMarkdownToHtml() {
                if (this.editor && this.editor.innerHTML) {
                    // Сохраняем оригинальный контент
                    const originalContent = this.editor.innerHTML;

                    // Создаем временный div для парсинга
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = originalContent;

                    // Проверяем, есть ли текстовые Markdown таблицы
                    const textContent = tempDiv.textContent || tempDiv.innerText || '';

                    // Регулярное выражение для поиска Markdown таблиц в тексте
                    const markdownTableRegex = /(\|[^\n]*\|\n\|[-:\|\s]+\|\n(\|[^\n]*\|\n?)*)/g;

                    if (markdownTableRegex.test(textContent)) {
                        // Конвертируем только если нашли таблицы
                        this.convertMarkdownTablesToHTML();
                    }

                    this.updateHiddenField();
                }
            }

            // Конвертация Markdown таблиц в HTML для визуального редактирования
            convertMarkdownTablesToHTML() {
                if (!this.editor) return;

                // Получаем текстовое содержимое редактора
                const textContent = this.editor.innerText;

                // Регулярное выражение для поиска Markdown таблиц
                const markdownTableRegex = /(\|[^\n]*\|\n\|[-:\|\s]+\|\n(\|[^\n]*\|\n?)*)/g;

                let hasChanges = false;
                let newContent = this.editor.innerHTML;

                let match;
                while ((match = markdownTableRegex.exec(textContent)) !== null) {
                    const markdownTable = match[0].trim();
                    const htmlTable = this.markdownTableToHTML(markdownTable);

                    if (htmlTable) {
                        // Заменяем текстовую таблицу на HTML
                        newContent = newContent.replace(match[0], htmlTable);
                        hasChanges = true;
                    }
                }

                if (hasChanges) {
                    this.editor.innerHTML = newContent;
                    // Пересканируем таблицы после конвертации
                    setTimeout(() => {
                        if (this.visualEditor) {
                            this.visualEditor.scanTables();
                        }
                    }, 100);
                }
            }

            // Конвертация одной Markdown таблицы в HTML
            markdownTableToHTML(markdown) {
                const lines = markdown.trim().split('\n').filter(line => line.trim());
                if (lines.length < 2) return null;

                let html = '<table class="table table-bordered visual-table" style="border-collapse: collapse; width: 100%; margin: 10px 0;">';

                lines.forEach((line, index) => {
                    // Пропускаем строки разделители
                    if (line.includes('---')) return;

                    const cells = line.split('|').filter((c, i, arr) => i > 0 && i < arr.length - 1);
                    if (cells.length === 0) return;

                    html += '<tr>';
                    cells.forEach(cellContent => {
                        const cellTag = index === 0 ? 'th' : 'td';
                        const content = cellContent.trim();
                        html += `<${cellTag} contenteditable="true" style="border: 1px solid #dee2e6; padding: 8px; outline: none; min-width: 50px;">${content}</${cellTag}>`;
                    });
                    html += '</tr>';
                });

                html += '</table>\n';
                return html;
            }

            // Конвертация HTML таблицы обратно в Markdown
            htmlTableToMarkdown(table) {
                const rows = Array.from(table.querySelectorAll('tr'));
                if (rows.length === 0) return '';

                let markdown = '\n';

                rows.forEach((row, rowIndex) => {
                    const cells = Array.from(row.querySelectorAll('th, td'));
                    let line = '|';

                    cells.forEach(cell => {
                        const text = cell.innerText.trim();
                        line += ` ${text} |`;
                    });

                    markdown += line + '\n';

                    // Добавляем разделитель после заголовка
                    if (rowIndex === 0) {
                        markdown += '|' + cells.map(() => ' --- |').join('') + '\n';
                    }
                });

                return markdown + '\n';
            }

            // Обработка изменений в редакторе
            handleEditorChange() {
                // Сохраняем позицию курсора
                const selection = window.getSelection();
                let range = null;
                if (selection.rangeCount > 0) {
                    range = selection.getRangeAt(0);
                }

                // Конвертируем новые Markdown таблицы в HTML
                this.convertMarkdownTablesToHTML();

                // Восстанавливаем позицию курсора
                if (range && this.editor.contains(range.startContainer)) {
                    selection.removeAllRanges();
                    selection.addRange(range);
                }

                this.updateHiddenField();
            }

            // Обновление скрытого поля перед отправкой
            updateHiddenField() {
                if (!this.editor) return;

                // Клонируем контент для обработки
                const tempDiv = this.editor.cloneNode(true);
                const tables = tempDiv.querySelectorAll('table.visual-table');

                // Конвертируем все HTML таблицы обратно в Markdown
                tables.forEach(table => {
                    const markdown = this.htmlTableToMarkdown(table);
                    const textNode = document.createTextNode(markdown);
                    table.parentNode.replaceChild(textNode, table);
                });


                  hiddenField.value = getEditorMarkdown();
            }

            // Вызывается при изменении таблицы
            onTableModified() {
                this.isProcessing = true;
                this.updateHiddenField();

                if (typeof this.onChange === 'function') {
                    this.onChange();
                }

                setTimeout(() => {
                    this.isProcessing = false;
                }, 100);
            }

            // Получить текущий контент
            getContent() {
                this.updateHiddenField();
                return this.hiddenField.value;
            }

            // Установить контент
            setContent(content) {
                const html =
                    this.convertMarkdownTextToHtml(content);
                this.editor.innerHTML = html;
                this.visualEditor?.scanTables();
            }
        }

        // Глобальная функция для инициализации
        function initTableEditorIntegration() {
            if (typeof VisualTableEditor !== 'undefined') {
                window.tableEditorIntegration = new TableEditorIntegration(
                    'markdownEditor',
                    'markdownPreview',
                    'hiddenMarkdownContent',
                    () => {
                        updatePreview();
                    }
                );
            }
        }
    </script>

