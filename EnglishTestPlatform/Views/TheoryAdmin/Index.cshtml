@model List<Data.Entities.Theory>
@{
    ViewData["Title"] = "Управление теорией";
}
<div class="container mt-4">
    <h1>Теоретические материалы</h1>
    <a href="@Url.Action("Create")" class="btn btn-primary mb-3">Добавить теорию</a>
    <table class="table table-bordered">
        <thead>
            <tr><th>ID</th><th>Название</th><th>Файл</th><th>Действия</th></tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Id</td>
                    <td>@t.Name</td>
                    <td>@t.File.Name</td>
                    <td>
                        <a href="@Url.Action("Edit", new { id = t.Id })" class="btn btn-sm btn-warning">Изменить</a>
                        <a href="@Url.Action("ManageTests", new { id = t.Id })" class="btn btn-sm btn-info">Связать тесты</a>
                        <form asp-action="Delete" method="post" style="display:inline">
                            <input type="hidden" name="id" value="@t.Id" />
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить?')">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>